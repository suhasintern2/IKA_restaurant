import re
from typing import Any, Dict, List


ORDER_NO_RE = re.compile(
    r"\b(?:ORDER\s*NO|ORDER|NO)\s*[:#]?\s*(?:NO\s*[:#]?\s*)?(\d{1,6})\b",
    re.IGNORECASE,
)
DATE_RE = re.compile(
    r"\b(?:date|dated)\s*[:\-]?\s*([0-3]?\d[/-][01]?\d[/-](?:\d{2}|\d{4})|\d{4}[/-][01]?\d[/-][0-3]?\d)\b",
    re.IGNORECASE,
)
TIME_RE = re.compile(r"\b(?:time)\s*[:\-]?\s*(\d{1,2}:\d{2}(?:\s*[AP]M)?)\b", re.IGNORECASE)
MARKER_RE = re.compile(r"\*{0,2}\s*(VOID(?:ED)?|DISCOUNT|PROMO(?:TION)?)\s*\*{0,2}", re.IGNORECASE)
LABEL_RE = re.compile(r"^\s*([A-Za-z][A-Za-z /_-]{1,30}?)\s*[:\-]\s*(.+?)\s*$")


def _clean(value: str) -> str:
    return re.sub(r"\s+", " ", value).strip(" :-")


def _printed_lines(lines: List[str]) -> List[str]:
    """Identify lines that look like printed docket metadata or item content."""
    result = []
    for line in lines:
        if (
            ORDER_NO_RE.search(line)
            or DATE_RE.search(line)
            or TIME_RE.search(line)
            or MARKER_RE.search(line)
            or LABEL_RE.match(line)
            or re.search(r"\b(?:TAKE AWAY|RESTAURANT|TABLE|CATEGORY|BIRYANI|RICE)\b", line, re.IGNORECASE)
        ):
            result.append(line)
    return result


def _handwritten_reason(lines: List[str], printed: List[str]) -> str:
    """Return OCR lines not explained by the printed docket grammar.

    This is intentionally best-effort. OCR cannot reliably distinguish ink
    layers without a handwriting model, so uncertain or missing text remains
    visible through the raw OCR and review flag.
    """
    printed_set = {line.casefold() for line in printed}
    candidates = []
    for line in lines:
        if line.casefold() in printed_set:
            continue
        if len(re.findall(r"[A-Za-z]", line)) >= 3 and not re.fullmatch(r"[\d\s.,:/-]+", line):
            candidates.append(line)
    return _clean(" ".join(candidates)) if candidates else ""


def parse_docket_text(text: str) -> Dict[str, Any]:
    lines = [_clean(line) for line in text.splitlines() if _clean(line)]
    order_numbers = [match.group(1) for match in ORDER_NO_RE.finditer(text)]
    unique_order_numbers = list(dict.fromkeys(order_numbers))
    printed_lines = _printed_lines(lines)

    marker_matches = list(MARKER_RE.finditer(text))
    discrepancy_type = ""
    if marker_matches:
        marker = marker_matches[0].group(1).casefold()
        discrepancy_type = "void" if marker.startswith("void") else (
            "discount" if marker.startswith("discount") else "promotion"
        )

    item = ""
    if marker_matches:
        item_line = text[marker_matches[0].end():].splitlines()[0]
        item = _clean(re.sub(r"^\s*\d+(?:\s+|$)", "", item_line))
    if not item:
        for line in lines:
            if line in printed_lines and not LABEL_RE.match(line) and not ORDER_NO_RE.search(line):
                if not DATE_RE.search(line) and not TIME_RE.search(line):
                    item = line
                    break

    extra_fields: Dict[str, str] = {}
    known_labels = {"order", "order no", "order no.", "date", "dated", "time", "category"}
    for line in lines:
        match = LABEL_RE.match(line)
        if match:
            key = _clean(match.group(1))
            if key.casefold() not in known_labels:
                extra_fields[key] = _clean(match.group(2))

    ambiguous = len(unique_order_numbers) > 1
    return {
        "docket_order_no": unique_order_numbers[0] if len(unique_order_numbers) == 1 else None,
        "docket_date": (DATE_RE.search(text).group(1) if DATE_RE.search(text) else ""),
        "docket_time": (TIME_RE.search(text).group(1) if TIME_RE.search(text) else ""),
        "item": item,
        "discrepancy_type": discrepancy_type,
        "handwritten_reason": _handwritten_reason(lines, printed_lines),
        "printed_text": "\n".join(printed_lines),
        "extra_fields": extra_fields,
        "review_required": ambiguous or not unique_order_numbers or not discrepancy_type,
        "review_reason": (
            "Multiple docket order numbers detected in one image"
            if ambiguous else
            "Could not isolate one docket order number or discrepancy marker"
            if not unique_order_numbers or not discrepancy_type else
            ""
        ),
    }